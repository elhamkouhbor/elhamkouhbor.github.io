---
import { Picture } from "astro:assets";
import { copy, projects } from "../content/content";
import { type Lang } from "../i18n/locales";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = copy[lang].ui;
const out = "↗";
const list = projects(lang);
---
<section id="work" class="work" aria-labelledby="work-title">
  <div class="wrap">
    <h2 id="work-title" class="eyebrow eyebrow--rule work__label" data-reveal>{ui.selectedWork}</h2>

    <ol class="work__list">
      {list.map((p, i) => (
        <li class:list={["project", i % 2 === 1 && "project--flip"]} aria-labelledby={`p-${p.id}`}>
          <figure class="project__figure">
            <a class="project__media" href={p.link} data-reveal="img" tabindex="-1">
              <Picture src={p.image} alt={p.alt} formats={["avif", "webp"]} widths={[640, 960, 1300, 1700, 2000]}
                sizes="(max-width: 860px) 100vw, 64vw" class="project__img" />
            </a>
            <figcaption data-reveal style="--d:.1s">{p.caption}</figcaption>
          </figure>

          <div class="project__text">
            <p class="project__n" data-reveal aria-hidden="true">{p.n}</p>
            <h3 id={`p-${p.id}`} class="project__title display" data-reveal lang="en">{p.title}</h3>
            <p class="project__summary" data-reveal style="--d:.06s">{p.summary}</p>
            <p class="project__body" data-reveal style="--d:.12s">{p.body}</p>
            <dl class="project__meta" data-reveal style="--d:.18s">
              {p.meta.map((m) => (
                <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
              ))}
            </dl>
            <p class="project__links" data-reveal style="--d:.24s">
              <a class="text-link" href={p.link}>{p.linkLabel} <span class="arrow" aria-hidden="true">{out}</span></a>
              <a class="text-link text-link--quiet" href={p.source} rel="noopener">
                GitHub<span class="sr-only">{ui.repoFor(p.title)}</span> <span class="arrow" aria-hidden="true">{out}</span>
              </a>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .work { padding-block: clamp(3.5rem, 7vw, 6rem) clamp(5rem, 10vw, 8.5rem); }
  .work__label { margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem); }
  .work__list { display: grid; gap: clamp(5rem, 10vw, 9rem); }

  .project {
    display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: clamp(2.5rem, 5vw, 5rem); align-items: center;
  }
  .project--flip { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
  .project--flip .project__figure { order: 2; }

  .project__figure { display: grid; gap: 0.9rem; }
  .project__media { display: block; overflow: hidden; border-radius: 3px; background: var(--paper-deep); aspect-ratio: 20 / 13; }
  .project__media :global(picture) { display: block; height: 100%; transition: transform 1.8s var(--ease); }
  .project__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .project__media:hover :global(picture) { transform: scale(1.018); }
  .project__figure figcaption { font-size: var(--text-xs); letter-spacing: 0.02em; color: var(--ink-faint); }

  .project__text { display: grid; justify-items: start; align-content: center; }
  .project__n { font-family: var(--serif); font-weight: 300; font-size: 1.15rem; line-height: 1; color: var(--clay-deep); font-variant-numeric: lining-nums; letter-spacing: 0.04em; margin-bottom: 1.1rem; }
  .project__title { font-size: var(--display-md); line-height: 1; margin-bottom: 1.4rem; }
  .project__summary { font-family: var(--serif); font-size: var(--text-lg); font-weight: 360; line-height: 1.45; color: var(--ink); max-width: 25rem; margin-bottom: 1rem; }
  .project__body { color: var(--ink-soft); max-width: 25rem; font-size: 0.97rem; line-height: 1.7; }
  .project__meta { display: grid; gap: 0.45rem; width: 100%; max-width: 25rem; padding-block: 1rem; margin-block: 1.6rem 1.7rem; border-block: 1px solid var(--rule); font-size: var(--text-sm); }
  .project__meta div { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1rem; }
  .project__meta dt { color: var(--ink-faint); }
  .project__links { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; }

  @media (prefers-reduced-motion: reduce) { .project__media:hover :global(picture) { transform: none; } }
  @media (max-width: 860px) {
    .project, .project--flip { grid-template-columns: 1fr; row-gap: 2.2rem; }
    .project--flip .project__figure { order: 0; }
    .project__media { margin-inline: calc(var(--gutter) * -1); border-radius: 0; }
  }
</style>
