---
import { disciplines } from "../content/content";
---
<section id="disciplines" class="disc chapter" aria-labelledby="disc-title" data-chapter="04" data-chapter-title="Disciplines">
  <header class="chapter__head disc__head">
    <p class="kicker" data-reveal>Chapter 04</p>
    <h2 id="disc-title" class="chapter__title display" data-mask>
      <span><span>Four Ways</span></span><span><span>of Seeing</span></span>
    </h2>
  </header>

  <ol class="disc__list">
    {disciplines.map((d) => (
      <li class="disc__item" data-disc>
        <span class="disc__rule" aria-hidden="true" data-rule></span>
        <span class="disc__n" aria-hidden="true">{d.n}</span>
        <h3 class="disc__title display" data-reveal>{d.title}</h3>
        <div class="disc__body" data-reveal>
          <p class="disc__tool label">{d.tool}</p>
          <p class="disc__text">{d.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .disc { background: var(--ivory); }
  .disc__list { list-style: none; margin: 0; padding: 0; counter-reset: none; }
  .disc__item {
    position: relative;
    display: grid; grid-template-columns: 6rem minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(1rem, 3vw, 3rem); align-items: baseline;
    padding-block: clamp(2rem, 4.5vw, 3.75rem);
  }
  .disc__rule { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--ink); opacity: 0.22; transform-origin: left; }
  .disc__item:last-child { border-bottom: 1px solid var(--line); }
  .disc__n { font-family: var(--serif); font-style: italic; font-size: var(--step-2); color: var(--brass); line-height: 1; font-variant-numeric: lining-nums; }
  .disc__title { font-size: var(--step-3); line-height: 1; transition: color 0.5s var(--ease), transform 0.6s var(--ease); }
  .disc__item:hover .disc__title { color: var(--burgundy); transform: translateX(0.6rem); }
  .disc__body { display: grid; gap: 0.6rem; }
  .disc__tool { color: var(--burgundy); }
  .disc__text { color: var(--ink-soft); max-width: 28rem; }
  @media (prefers-reduced-motion: reduce) { .disc__item:hover .disc__title { transform: none; } }
  @media (max-width: 760px) {
    .disc__item { grid-template-columns: 3rem minmax(0, 1fr); row-gap: 1rem; }
    .disc__body { grid-column: 2; }
  }
</style>
