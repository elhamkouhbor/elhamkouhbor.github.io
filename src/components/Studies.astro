---
import { Picture, getImage } from "astro:assets";
import { featureStudy, studies, studiesIntro } from "../content/content";

// Large single-format version for the lightbox (loaded only when a study is opened).
const all = [featureStudy, ...studies];
const large = await Promise.all(all.map((s) => getImage({ src: s.image, width: 1800, format: "webp", quality: 82 })));
const largeById = Object.fromEntries(all.map((s, i) => [s.id, large[i]!.src]));
---
<section id="studies" class="studies chapter" aria-labelledby="studies-title" data-chapter="02" data-chapter-title="Form & Expression">
  <header class="chapter__head studies__head">
    <p class="kicker" data-reveal>{studiesIntro.kicker}</p>
    <h2 id="studies-title" class="chapter__title display" data-mask>
      {studiesIntro.title.map((t) => <span><span>{t}</span></span>)}
    </h2>
    <p class="lede" data-reveal>{studiesIntro.lede}</p>
    <p class="studies__label label" data-reveal><span class="studies__dot" aria-hidden="true"></span>{studiesIntro.label}</p>
  </header>

  <figure class="studies__feature" data-expand>
    <button class="studies__open" type="button" data-open-study={featureStudy.id} data-large={largeById[featureStudy.id]}
      data-title={featureStudy.title} data-subject={featureStudy.subject} data-alt={featureStudy.alt}
      aria-label={`Enlarge ${featureStudy.title}`}>
      <span class="studies__feature-frame" data-expand-frame>
        <Picture src={featureStudy.image} alt={featureStudy.alt} formats={["avif", "webp"]}
          widths={[640, 960, 1400, 1900, 2400]} sizes="100vw" class="figure-img" style={`object-position:${featureStudy.focus}`} data-parallax />
      </span>
    </button>
    <figcaption><strong>{featureStudy.title}.</strong> {featureStudy.subject}</figcaption>
  </figure>

  <div class="studies__grid">
    {studies.map((s, i) => (
      <figure class={`studies__item studies__item--${i + 1}`} data-reveal>
        <button class="studies__open" type="button" data-open-study={s.id} data-large={largeById[s.id]}
          data-title={s.title} data-subject={s.subject} data-alt={s.alt} aria-label={`Enlarge ${s.title}`}>
          <span class="studies__frame" style={`aspect-ratio:${s.image.width}/${s.image.height}`}>
            <Picture src={s.image} alt={s.alt} formats={["avif", "webp"]} widths={[420, 640, 900, 1200]}
              sizes="(max-width: 760px) 92vw, 42vw" class="figure-img" style={s.focus ? `object-position:${s.focus}` : undefined} data-parallax />
          </span>
        </button>
        <figcaption><strong>{s.title}.</strong> {s.subject}</figcaption>
      </figure>
    ))}
  </div>

  <dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
    <div class="lightbox__inner">
      <img class="lightbox__img" alt="" data-lightbox-img decoding="async" />
      <div class="lightbox__meta">
        <p id="lightbox-title" class="lightbox__title display" data-lightbox-title></p>
        <p class="lightbox__subject" data-lightbox-subject></p>
        <p class="label">Conceptual study · not client work</p>
      </div>
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close enlarged study">
        <span aria-hidden="true">Close</span>
      </button>
    </div>
  </dialog>
</section>

<style>
  .studies { background: var(--ivory); padding-bottom: clamp(5rem, 10vw, 9rem); }
  .studies__head { grid-template-columns: minmax(0, 1fr); max-width: 72rem; }
  .studies__label { display: inline-flex; align-items: center; gap: 0.8rem; color: var(--burgundy); }
  .studies__dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--burgundy); flex: none; }

  .studies__open {
    display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; color: inherit; text-align: inherit;
  }
  .studies__feature { margin: 0 calc(var(--gutter) * -1) clamp(5rem, 10vw, 9rem); display: grid; gap: 1rem; }
  .studies__feature-frame {
    display: block; overflow: hidden; aspect-ratio: 12 / 7; max-height: 92svh; width: 100%;
    background: var(--paper);
  }
  html:global(.anim) .studies__feature-frame { clip-path: inset(6% 14% 6% 14%); }
  .studies__feature figcaption { padding-inline: var(--gutter); max-width: 50rem; }

  .studies__frame { display: block; overflow: hidden; background: var(--paper); }
  .studies__frame :global(img), .studies__feature-frame :global(img) { transition: transform 1.2s var(--ease); }
  .studies__open:hover :global(img) { transform: scale(1.035); }
  .studies__frame :global(picture), .studies__feature-frame :global(picture) { display: block; height: 100%; }
  .studies__item { display: grid; gap: 1rem; align-content: start; }

  .studies__grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2.5rem); row-gap: clamp(4rem, 9vw, 8rem);
  }
  .studies__item--1 { grid-column: 1 / span 5; }
  .studies__item--2 { grid-column: 7 / span 6; margin-top: clamp(4rem, 12vw, 12rem); }
  .studies__item--3 { grid-column: 2 / span 5; }
  .studies__item--4 { grid-column: 8 / span 5; margin-top: clamp(-6rem, -6vw, -2rem); }
  .studies__item--5 { grid-column: 3 / span 9; }

  @media (max-width: 760px) {
    .studies__grid { grid-template-columns: 1fr; row-gap: 3.5rem; }
    .studies__grid > .studies__item { grid-column: 1 / -1; margin-top: 0; }
    .studies__item--2, .studies__item--4 { padding-left: 12%; }
    .studies__item--3 { padding-right: 12%; }
    .studies__feature-frame { aspect-ratio: 4 / 5; }
    .studies__feature-frame :global(img) { object-position: 38% 50% !important; }
    html:global(.anim) .studies__feature-frame { clip-path: inset(4% 8% 4% 8%); }
  }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgb(30 26 27 / 0.96); color: var(--ivory);
  }
  .lightbox::backdrop { background: rgb(30 26 27 / 0.6); }
  .lightbox[open] { animation: lb-in 0.45s var(--ease); }
  @keyframes lb-in { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .lightbox[open] { animation: none; } }
  .lightbox__inner {
    height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 2rem; align-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .lightbox__img { width: 100%; height: 100%; max-height: calc(100dvh - 6rem); object-fit: contain; }
  .lightbox__meta { display: grid; gap: 1rem; align-self: end; padding-bottom: 2rem; }
  .lightbox__meta .label { color: var(--brass-bright); }
  .lightbox__title { font-size: var(--step-2); line-height: 1.05; }
  .lightbox__subject { color: rgb(245 242 236 / 0.75); }
  .lightbox__close {
    position: absolute; top: clamp(1rem, 3vw, 2rem); right: clamp(1rem, 3vw, 2rem);
    background: none; border: 1px solid rgb(245 242 236 / 0.4); color: inherit; cursor: pointer; border-radius: 999px;
    padding: 0.6rem 1.2rem; font: inherit; font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 600;
  }
  .lightbox__close:hover { background: var(--ivory); color: var(--ink); }
  .lightbox :focus-visible { outline-color: var(--brass-bright); }
  @media (max-width: 760px) {
    .lightbox__inner { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) auto; padding-top: 4.5rem; }
    .lightbox__img { max-height: none; }
    .lightbox__meta { padding-bottom: 0.5rem; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (dialog && typeof dialog.showModal === "function") {
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const title = dialog.querySelector<HTMLElement>("[data-lightbox-title]")!;
    const subject = dialog.querySelector<HTMLElement>("[data-lightbox-subject]")!;
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLButtonElement>("[data-open-study]").forEach((btn) => {
      btn.addEventListener("click", () => {
        opener = btn;
        img.src = btn.dataset.large ?? "";
        img.alt = btn.dataset.alt ?? "";
        title.textContent = btn.dataset.title ?? "";
        subject.textContent = btn.dataset.subject ?? "";
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
      });
    });
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => { if (e.target === dialog || e.target === dialog.firstElementChild) dialog.close(); });
    dialog.addEventListener("close", () => { document.documentElement.style.overflow = ""; opener?.focus(); });
  } else {
    // Very old browsers: buttons do nothing harmful; make them look non-interactive.
    document.querySelectorAll<HTMLElement>("[data-open-study]").forEach((b) => (b.style.cursor = "default"));
  }
</script>
