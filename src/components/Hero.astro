---
import { Picture } from "astro:assets";
import { hero } from "../content/content";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__art" aria-hidden="true">
    <div class="hero__stage" data-sculpture>
    <Picture
      src={hero.image}
      alt=""
      formats={["avif", "webp"]}
      widths={[700, 1000, 1400, 1900, 2800]}
      sizes="(max-width: 820px) 100vw, 66vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    </div>
  </div>
  <div class="hero__text wrap">
    <p class="eyebrow eyebrow--rule hero__in" style="--i:0">{hero.kicker}</p>
    <h1 id="hero-title" class="hero__title display">
      <span class="hero__in" style="--i:1">Elham</span>
      <span class="hero__in" style="--i:2">Kouhbor</span>
    </h1>
    <p class="lead hero__in" style="--i:3">{hero.intro}</p>
    <a class="text-link hero__in" style="--i:4" href={hero.cta.href}>{hero.cta.label} <span class="arrow arrow--down" aria-hidden="true">↓</span></a>
  </div>
</section>

<script>
  // The hero image is the first frame of a slowly morphing 3D paper sculpture. When motion is allowed and
  // the device can render it, the live version loads after the page and fades in over the identical image.
  // Reduced motion, Save-Data, missing WebGL 2 or any error keep the static image.
  const stage = document.querySelector<HTMLElement>("[data-sculpture]");
  const img = stage?.querySelector<HTMLImageElement>("img");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");
  let started = false;
  const eligible = () => {
    if (!stage || !img || reduce.matches || started) return false;
    if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return false;
    try { // software-only WebGL (no GPU) would be slow and drain the battery: keep the image there
      const gl = document.createElement("canvas").getContext("webgl2", { failIfMajorPerformanceCaveat: true });
      gl?.getExtension("WEBGL_lose_context")?.loseContext();
      return !!gl;
    } catch { return false; }
  };
  const start = () => {
    if (!eligible()) return;
    started = true;
    import("../scripts/sculpture/live")
      .then((m) => m.mount(stage!, img!))
      .then((s) => { (stage as HTMLElement & { sculpture?: unknown }).sculpture = s; }) // inspected by the tests
      .catch(() => { /* the static image stays */ });
  };
  const later = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 600));
  if (document.readyState === "complete") later(); else addEventListener("load", later, { once: true });
  reduce.addEventListener("change", () => { if (!reduce.matches) later(); });
</script>

<style>
  .hero { position: relative; min-height: min(100svh, 62rem); display: grid; align-items: center; overflow: hidden; }
  .hero__art {
    position: absolute; inset: 0 0 0 auto; width: 68%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 30%), linear-gradient(to top, transparent 0%, #000 14%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0%, #000 30%), linear-gradient(to top, transparent 0%, #000 14%);
    mask-composite: intersect;
  }
  .hero__stage { position: absolute; inset: 0; }
  .hero__art :global(picture) { display: block; height: 100%; }
  .hero__stage :global(canvas.hero__live) {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.6s var(--ease);
  }
  .hero__stage :global(canvas.hero__live.is-live) { opacity: 1; }
  .hero__art :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 72% 50%; }
  .hero__text { position: relative; display: grid; justify-items: start; gap: clamp(1.4rem, 2.6vw, 2rem); padding-block: 8rem 6rem; }
  .hero__title { font-size: var(--display-lg); font-weight: 320; line-height: 0.95; letter-spacing: -0.035em; }
  .hero__title span { display: block; }
  .hero .lead { max-width: 27rem; }

  /* Intro: a calm, staggered settle (only when motion is allowed). */
  :global(html.intro) .hero__in { animation: rise 1.4s var(--ease) both; animation-delay: calc(0.25s + var(--i) * 0.12s); }
  :global(html.intro) .hero__art { animation: fade 2.4s var(--ease) both; }
  :global(html.intro) .hero__stage { animation: settle 7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
  @keyframes fade { from { opacity: 0; } }
  @keyframes settle { from { transform: scale(1.045); } }

  @media (max-width: 820px) {
    .hero { min-height: 0; align-items: end; }
    .hero__art {
      position: relative; inset: auto; width: 100%; height: 62svh; max-height: 34rem; grid-row: 1;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 30%); mask-image: linear-gradient(to top, transparent 0%, #000 30%);
    }
    .hero__art :global(img) { object-position: 62% 42%; }
    .hero__text { grid-row: 2; margin-top: -5rem; padding-block: 0 4.5rem; }
    .hero__title { font-size: clamp(3.2rem, 15vw, 5rem); }
  }
</style>
