---
import { chapters, site } from "../config/site";
import Monogram from "./Monogram.astro";
---
<header class="site-header" data-header data-tone="light">
  <a class="site-header__mark" href="#arrival" aria-label={`${site.name} — back to the top`}>
    <Monogram class="site-header__monogram" title="EK" />
    <span class="site-header__name">Elham Kouhbor</span>
  </a>

  <p class="site-header__chapter" aria-hidden="true">
    <span data-chapter-n>01</span><span class="site-header__sep">/</span><span>06</span>
    <span class="site-header__chapter-title" data-chapter-title>Arrival</span>
  </p>

  <nav class="site-header__nav" aria-label="Chapters">
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="chapter-menu" data-menu-toggle>
      <span class="site-header__toggle-label">Index</span>
      <span class="site-header__toggle-icon" aria-hidden="true"></span>
    </button>
    <ol id="chapter-menu" class="site-header__menu" data-menu>
      {chapters.map((c) => (
        <li><a href={`#${c.id}`}><span class="n">{c.n}</span>{c.title}</a></li>
      ))}
    </ol>
  </nav>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem;
    padding: calc(0.9rem + env(safe-area-inset-top)) var(--gutter) 0.9rem;
    color: var(--ink);
    transition: color 0.5s var(--ease), background-color 0.5s var(--ease), transform 0.5s var(--ease);
    pointer-events: none;
  }
  .site-header > * { pointer-events: auto; }
  .site-header[data-tone="dark"] { color: var(--ivory); }
  .site-header[data-scrolled] { background: linear-gradient(to bottom, rgb(245 242 236 / 0.92), rgb(245 242 236 / 0)); }
  .site-header[data-scrolled][data-tone="dark"] { background: linear-gradient(to bottom, rgb(30 26 27 / 0.85), rgb(30 26 27 / 0)); }

  .site-header__mark { display: inline-flex; align-items: center; gap: 0.8rem; text-decoration: none; justify-self: start; }
  .site-header__mark :global(.site-header__monogram) { width: 2.6rem; }
  .site-header__name { font-size: var(--step--1); font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; }

  .site-header__chapter {
    display: flex; align-items: baseline; gap: 0.35rem; margin: 0;
    font-size: var(--step--1); font-variant-numeric: tabular-nums; letter-spacing: 0.12em;
  }
  .site-header__sep { opacity: 0.45; }
  .site-header__chapter-title { margin-left: 0.8rem; font-family: var(--serif); font-style: italic; letter-spacing: 0.02em; font-size: 1.05rem; }

  .site-header__nav { justify-self: end; position: relative; }
  .site-header__toggle {
    display: inline-flex; align-items: center; gap: 0.7rem; padding: 0.55rem 0; border: 0; background: none;
    color: inherit; font: inherit; font-size: var(--step--1); font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer;
  }
  .site-header__toggle-icon { width: 1.4rem; height: 0.45rem; border-block: 1px solid currentColor; transition: transform 0.4s var(--ease), height 0.4s var(--ease); }
  .site-header__toggle[aria-expanded="true"] .site-header__toggle-icon { height: 0; border-bottom-width: 0; transform: rotate(45deg); }

  .site-header__menu {
    position: absolute; right: 0; top: calc(100% + 0.6rem); min-width: 16rem;
    list-style: none; margin: 0; padding: 0.8rem 0;
    background: var(--ivory); color: var(--ink); box-shadow: 0 24px 60px -24px rgb(40 38 35 / 0.45);
    border: 1px solid var(--line);
    opacity: 0; visibility: hidden; transform: translateY(-0.5rem);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease), visibility 0s linear 0.35s;
  }
  .site-header__menu[data-open] { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .site-header__menu a {
    display: flex; gap: 1rem; align-items: baseline; padding: 0.55rem 1.4rem; text-decoration: none;
    font-family: var(--serif); font-size: 1.25rem;
  }
  .site-header__menu a:hover, .site-header__menu a:focus-visible { background: var(--paper); }
  .site-header__menu .n { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--burgundy); font-weight: 600; }

  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; }
    .site-header__chapter { display: none; }
    .site-header__name { display: none; }
  }
  @media (max-width: 380px) { .site-header__menu { min-width: min(16rem, calc(100vw - 2.5rem)); } }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (header && toggle && menu) {
    const setOpen = (open: boolean, focusToggle = false) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.toggleAttribute("data-open", open);
      if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
      else if (focusToggle) toggle.focus();
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) setOpen(false); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu.hasAttribute("data-open")) setOpen(false, true); });
    document.addEventListener("click", (e) => { if (!header.contains(e.target as Node)) setOpen(false); });
    const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
