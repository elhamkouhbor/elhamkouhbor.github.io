---
// Original line pictograms for the tools list (24 × 24 grid, 1.4 stroke). They describe the kind of work
// (image editing, vector drawing, page layout, technical drawing) rather than copying product logos.
interface Props { icon: "image" | "vector" | "layout" | "drafting" }
const { icon } = Astro.props;
---
<svg class="tool-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {icon === "image" && (
    <g>
      <rect x="3.5" y="5" width="17" height="14" rx="2.2" />
      <path d="M3.9 16.6 8.6 12l3.9 3.8 2.6-2.5 5 4.9" />
      <circle class="accent-fill" cx="15.4" cy="9.4" r="1.7" />
    </g>
  )}
  {icon === "vector" && (
    <g>
      <path d="M5.2 17.6C7.4 6.6 16.6 6.6 18.8 17.6" />
      <path class="thin" d="M5.2 17.6 7.6 6.4M18.8 17.6 16.4 6.4" />
      <circle cx="7.6" cy="6.4" r="1.25" />
      <circle cx="16.4" cy="6.4" r="1.25" />
      <rect class="accent-fill" x="3.8" y="16.2" width="2.8" height="2.8" rx=".4" />
      <rect class="accent-fill" x="17.4" y="16.2" width="2.8" height="2.8" rx=".4" />
    </g>
  )}
  {icon === "layout" && (
    <g>
      <rect x="5" y="3.5" width="14" height="17" rx="1.6" />
      <rect class="accent-fill" x="7.8" y="6.4" width="8.4" height="2.4" rx=".5" />
      <path class="thin" d="M7.8 11.6h3.4M7.8 14.1h3.4M7.8 16.6h3.4M12.8 11.6h3.4M12.8 14.1h3.4M12.8 16.6h2.2" />
    </g>
  )}
  {icon === "drafting" && (
    <g>
      <path d="M11 3.6 17 7 11 10.4 5 7Z" />
      <path d="M5 7v7l6 3.4 6-3.4V7M11 10.4v7" />
      <path class="accent" d="M19.6 8.6v6.8M18.4 8.6h2.4M18.4 15.4h2.4" />
    </g>
  )}
</svg>

<style>
  .tool-icon { display: block; width: 1.35rem; height: 1.35rem; fill: none; stroke: var(--ink); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .tool-icon .thin { stroke-width: 1.1; opacity: 0.75; }
  .tool-icon circle:not(.accent-fill) { fill: var(--paper-light); }
  .tool-icon .accent-fill { fill: var(--tool-accent, var(--clay)); stroke: none; }
  .tool-icon .accent { stroke: var(--tool-accent, var(--clay)); stroke-width: 1.3; }
</style>
