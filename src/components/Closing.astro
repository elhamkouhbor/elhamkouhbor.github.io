---
import { closing as c } from "../content/content";
import { contactLinks, site } from "../config/site";
import Monogram from "./Monogram.astro";
const links = contactLinks();
const year = new Date().getFullYear();
---
<section id="contact" class="closing chapter on-dark" aria-labelledby="closing-title" data-chapter="06" data-chapter-title="Contact" data-tone="dark">
  <p class="kicker" data-reveal>{c.kicker}</p>
  <h2 id="closing-title" class="closing__title display" data-mask>
    {c.title.map((t) => <span><span>{t}</span></span>)}
  </h2>
  <div class="closing__row">
    <p class="lede" data-reveal>{c.lede}</p>
    {links.length > 0 && (
      <ul class="closing__links" data-reveal>
        {links.map((l) => (
          <li>
            <a href={l.href} rel={l.href.startsWith("http") ? "me noopener" : undefined} class="closing__link">
              <span class="closing__link-label">{l.label}</span>
              <span class="closing__link-handle">{l.handle}</span>
              <span class="closing__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<footer class="footer on-dark">
  <div class="footer__brand">
    <Monogram class="footer__monogram" title="EK" />
    <p>© {year} {site.name}</p>
  </div>
  <p class="footer__note">All imagery on this site is original conceptual work — digital studies of paper, fold and light, not client projects. Typeset in Bodoni Moda and Manrope.</p>
  <a class="footer__top link-underline" href="#arrival">Back to top ↑</a>
</footer>

<style>
  .closing { background: var(--ink); padding-bottom: clamp(5rem, 9vw, 8rem); display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .closing__title { font-size: var(--step-5); line-height: 0.9; }
  .closing__title > span:last-child { font-style: italic; color: var(--brass-bright); padding-left: clamp(1rem, 8vw, 10rem); }
  .closing__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: end; margin-top: clamp(1.5rem, 4vw, 3rem); }
  .closing__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .closing__link {
    display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 1.5rem;
    padding: 1.4rem 0; border-top: 1px solid rgb(245 242 236 / 0.25); border-bottom: 1px solid rgb(245 242 236 / 0.25);
    text-decoration: none; color: var(--ivory);
  }
  .closing__link-label { font-family: var(--serif); font-size: var(--step-2); line-height: 1; }
  .closing__link-handle { font-size: var(--step--1); letter-spacing: 0.08em; color: rgb(245 242 236 / 0.6); overflow-wrap: anywhere; }
  .closing__arrow { font-size: var(--step-1); transition: transform 0.5s var(--ease); }
  .closing__link:hover .closing__arrow, .closing__link:focus-visible .closing__arrow { transform: translateX(0.6rem); }
  .closing__link:hover .closing__link-label { font-style: italic; color: var(--brass-bright); }

  .footer {
    background: var(--ink); color: rgb(245 242 236 / 0.7);
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 2rem; align-items: center;
    padding: 2rem var(--gutter) calc(2rem + env(safe-area-inset-bottom)); border-top: 1px solid rgb(245 242 236 / 0.12);
    font-size: var(--step--1);
  }
  .footer__brand { display: flex; align-items: center; gap: 1rem; color: var(--ivory); }
  .footer__brand :global(.footer__monogram) { width: 2.4rem; }
  .footer__note { max-width: 40rem; }
  .footer__top { color: var(--ivory); justify-self: end; white-space: nowrap; }
  @media (max-width: 760px) {
    .closing__row { grid-template-columns: 1fr; }
    .closing__title { font-size: clamp(3rem, 14vw, 6rem); }
    .footer { grid-template-columns: 1fr; }
    .footer__top { justify-self: start; }
  }
</style>
