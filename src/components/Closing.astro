---
import { Picture } from "astro:assets";
import { closing } from "../content/content";
import { contactLinks, site } from "../config/site";
const links = contactLinks();
const year = new Date().getFullYear();
---
<section id="contact" class="closing" aria-labelledby="closing-title">
  <div class="wrap closing__inner">
    <span class="closing__rule" aria-hidden="true" data-reveal></span>
    <h2 id="closing-title" class="closing__title display" data-reveal>{closing.title}</h2>
    <p class="closing__text" data-reveal style="--d:.05s">{closing.text}</p>
    {links.length > 0 && (
      <ul class="closing__links" data-reveal style="--d:.1s">
        {links.map((l) => (
          <li>
            <a class="text-link" href={l.href} rel={l.href.startsWith("http") ? "me noopener" : undefined}>
              {l.label} <span class="closing__handle">{l.handle}</span> <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class="closing__art" aria-hidden="true">
    <div class="closing__stage" data-sculpture="closing">
      <Picture src={closing.image} alt="" formats={["avif", "webp"]} widths={[800, 1400, 2000, 2800]} sizes="100vw" class="closing__img" />
    </div>
  </div>
</section>

<footer class="footer wrap">
  <p>© {year} {site.name}</p>
  <p class="footer__note">Project images show the real applications. All other images are original digital renders.</p>
  <a href="#main" class="footer__top">Back to top <span aria-hidden="true">↑</span></a>
</footer>

<style>
  .closing { position: relative; overflow: hidden; padding-block: clamp(6rem, 12vw, 10rem) 0; }
  .closing__inner { position: relative; z-index: 1; display: grid; justify-items: start; gap: 1.6rem; }
  .closing__rule { width: 3.5rem; height: 1px; background: var(--clay); }
  .closing__title { font-size: var(--display-md); max-width: 15ch; line-height: 1.04; }
  .closing__text { color: var(--ink-soft); max-width: 30rem; margin-top: -0.4rem; }
  .closing__links { display: grid; gap: 0.8rem; margin-top: 0.6rem; }
  .closing__handle { color: var(--ink-faint); font-weight: 400; font-size: var(--text-sm); margin-left: 0.4rem; }
  .closing__art {
    position: relative; margin-top: clamp(-6rem, -6vw, -2rem); aspect-ratio: 28 / 10; min-height: 14rem;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 45%); mask-image: linear-gradient(to bottom, transparent 0%, #000 45%);
  }
  .closing__stage { position: absolute; inset: 0; }
  .closing__art :global(picture) { display: block; height: 100%; }
  .closing__art :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }

  .footer {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1.5rem 2.5rem; align-items: baseline;
    padding-block: 1.8rem calc(1.8rem + env(safe-area-inset-bottom)); border-top: 1px solid var(--rule);
    font-size: var(--text-xs); color: var(--ink-soft); letter-spacing: 0.02em;
  }
  .footer__note { color: var(--ink-faint); }
  .footer__top { text-decoration: none; }
  .footer__top:hover { color: var(--ink); }
  @media (max-width: 760px) {
    .footer { grid-template-columns: 1fr; gap: 0.6rem; }
    .closing__art { aspect-ratio: 16 / 9; }
  }
</style>
