---
import { Picture } from "astro:assets";
import { site } from "../config/site";
import { hero } from "../content/content";
import Monogram from "./Monogram.astro";
---
<section id="arrival" class="arrival" aria-labelledby="arrival-title" data-chapter="01" data-chapter-title="Arrival">
  <div class="arrival__text">
    <Monogram class="arrival__monogram" animated />
    <h1 id="arrival-title" class="arrival__name display" data-mask>
      <span><span>Elham</span></span>
      <span><span>Kouhbor</span></span>
    </h1>
    <p class="arrival__role" data-reveal>{site.role}</p>
    <p class="arrival__tagline" aria-label={site.tagline.join(" ")}>
      {site.tagline.map((w) => <span class="arrival__word" aria-hidden="true" data-reveal>{w}</span>)}
    </p>
  </div>

  <figure class="arrival__figure" data-hero-figure>
    <div class="arrival__frame" data-hero-frame>
      <Picture
        src={hero.image}
        alt={hero.alt}
        formats={["avif", "webp"]}
        widths={[480, 720, 960, 1200, 1500]}
        sizes="(max-width: 760px) 92vw, 38vw"
        loading="eager"
        fetchpriority="high"
        class="figure-img arrival__img"
        data-hero-img
      />
    </div>
    <figcaption data-reveal><strong>Study 0 — Column.</strong> Conceptual digital study: one sheet, pleated into a column of light.</figcaption>
  </figure>

  <a class="arrival__scroll" href="#studies" data-reveal>
    <span>Scroll</span><span class="arrival__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .arrival {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: end;
    padding: calc(6.5rem + env(safe-area-inset-top)) var(--gutter) clamp(2.5rem, 5vw, 4.5rem);
    background:
      radial-gradient(120% 80% at 0% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      var(--ivory);
  }
  .arrival__text { display: grid; gap: clamp(1.2rem, 2.5vw, 2rem); align-content: end; padding-bottom: 3.5rem; }
  .arrival__text :global(.arrival__monogram) { width: clamp(6.5rem, 12vw, 11rem); color: var(--ink); margin-bottom: clamp(0.5rem, 3vh, 2.5rem); }
  .arrival__name {
    font-size: clamp(3.6rem, min(10.2vw, 19vh), 13rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 0.86;
    font-weight: 400;
  }
  .arrival__name > span:last-child { padding-left: 0.42em; font-style: italic; color: var(--burgundy); text-transform: none; letter-spacing: -0.02em; }
  .arrival__role {
    font-size: var(--step--1); font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ink-soft);
    padding-left: 0.2rem;
  }
  .arrival__tagline { display: flex; flex-wrap: wrap; gap: 0 0.7em; font-family: var(--serif); font-size: var(--step-2); font-style: italic; line-height: 1.2; }
  .arrival__word:nth-child(2) { color: var(--sage-deep); }
  .arrival__word:nth-child(3) { color: var(--burgundy); }

  .arrival__figure { display: grid; gap: 0.9rem; align-self: stretch; padding-bottom: 3.5rem; }
  .arrival__frame {
    position: relative; overflow: hidden; height: 100%; min-height: 24rem; max-height: calc(100svh - 12rem);
    background: var(--plum);
    clip-path: inset(0 0 0 0);
  }
  .arrival__frame :global(picture) { display: block; height: 100%; }
  .arrival__frame :global(img) { height: 100%; width: 100%; object-fit: cover; object-position: 50% 40%; }
  html:global(.anim) .arrival__frame { clip-path: inset(100% 0 0 0); }

  .arrival__scroll {
    position: absolute; left: var(--gutter); bottom: clamp(1.2rem, 3vw, 2rem);
    display: inline-flex; align-items: center; gap: 1rem; text-decoration: none;
    font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft);
  }
  .arrival__scroll-line { width: 4.5rem; height: 1px; background: currentColor; transform-origin: left; animation: scroll-line 2.6s var(--ease) infinite; }
  @keyframes scroll-line { 0% { transform: scaleX(0); } 50% { transform: scaleX(1); transform-origin: left; } 51% { transform-origin: right; } 100% { transform: scaleX(0); transform-origin: right; } }
  @media (prefers-reduced-motion: reduce) { .arrival__scroll-line { animation: none; } }

  @media (max-width: 760px) {
    .arrival { grid-template-columns: 1fr; align-items: start; gap: 2rem; padding-top: calc(5.5rem + env(safe-area-inset-top)); }
    .arrival__text { padding-bottom: 0; }
    .arrival__name { font-size: clamp(3.2rem, 17vw, 6rem); }
    .arrival__figure { padding-bottom: 3rem; }
    .arrival__frame { height: auto; aspect-ratio: 4 / 5; min-height: 0; max-height: none; }
  }
  @media (min-width: 761px) and (max-height: 640px) {
    .arrival__text :global(.arrival__monogram) { display: none; }
  }
</style>
