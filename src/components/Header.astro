---
import { contact, nav, site } from "../config/site";
import { copy } from "../content/content";
import { langs, locales, type Lang } from "../i18n/locales";
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = copy[lang].ui;
---
<header class="top wrap">
  <a class="top__name" href={locales[lang].path} aria-label={ui.home}>{site.name}</a>
  <div class="top__end">
    <nav aria-label={ui.primaryNav}>
      <ul class="top__nav">
        {nav.map((id) => <li><a href={`#${id}`}>{ui.nav[id]}</a></li>)}
        {contact.github && <li class="top__gh"><a href={contact.github} rel="me noopener">GitHub<span class="sr-only"> {ui.opensGithub}</span> <span aria-hidden="true">{locales[lang].out}</span></a></li>}
      </ul>
    </nav>
    <nav aria-label={ui.language}>
      <ul class="top__lang">
        {langs.map((l) => (
          <li>
            <a href={locales[l].path} hreflang={locales[l].tag} lang={locales[l].tag}
              aria-label={locales[l].name} aria-current={l === lang ? "page" : undefined} title={locales[l].name}>{locales[l].short}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .top {
    position: absolute; inset: 0 0 auto 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding-block: calc(1.6rem + env(safe-area-inset-top)) 1.6rem;
  }
  .top__name { font-family: var(--serif); font-size: 1.3rem; font-weight: 400; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; }
  .top__end { display: flex; align-items: center; gap: clamp(1.1rem, 3vw, 2.6rem); }
  .top__nav { display: flex; gap: clamp(1.1rem, 3vw, 2.6rem); font-size: var(--text-sm); }
  .top__nav a, .top__lang a { text-decoration: none; position: relative; padding-block: 0.4rem; }
  .top__nav a::after, .top__lang a::after { content: ""; position: absolute; inset-inline: 0; bottom: 0; height: 1px; background: var(--clay); transform: scaleX(0); transform-origin: right; transition: transform 0.5s var(--ease); }
  .top__nav a:hover::after, .top__lang a:hover::after { transform: scaleX(1); transform-origin: left; }

  /* Language switcher: three quiet labels after a hairline, the current one underlined. */
  .top__lang { display: flex; align-items: center; gap: 0.15rem; padding-inline-start: clamp(1.1rem, 3vw, 2.6rem); border-inline-start: 1px solid var(--rule); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; }
  .top__lang a { display: inline-block; min-width: 2rem; padding: 0.55rem 0.3rem; text-align: center; color: var(--ink-soft); }
  /* The Farsi label uses the system's Persian font on the English and Swedish pages, so they never download Vazirmatn. */
  .top__lang a[lang="fa"] { font-family: Tahoma, "Noto Sans Arabic", "Segoe UI", system-ui, sans-serif; font-size: 0.85rem; font-weight: 500; letter-spacing: 0; line-height: 1; }
  :global(:root:lang(fa)) .top__lang a[lang="fa"] { font-family: var(--sans-fa); }
  .top__lang a[aria-current="page"] { color: var(--ink); }
  .top__lang a[aria-current="page"]::after { transform: scaleX(1); inset-inline: 0.45rem; }
  .top__lang a:hover { color: var(--ink); }

  @media (max-width: 640px) {
    /* Small screens: the name on its own line, links and languages beneath it. */
    .top { flex-wrap: wrap; row-gap: 0.4rem; }
    .top__end { width: 100%; justify-content: space-between; }
    .top__lang { border: 0; padding: 0; margin-inline-end: -0.3rem; }
  }
  @media (max-width: 420px) { .top__nav { gap: 1rem; } .top__name { font-size: 1.15rem; } }
</style>
