---
import { copy, tools } from "../content/content";
import type { Lang } from "../i18n/locales";
interface Props { lang: Lang }
const { lang } = Astro.props;
const practice = copy[lang].practice;
import ToolIcon from "./ToolIcon.astro";
---
<section id="practice" class="practice" aria-labelledby="practice-title">
  <div class="wrap practice__grid">
    <h2 id="practice-title" class="practice__title display" data-reveal>{practice.title}</h2>
    <div class="practice__body">
      <div class="practice__intro">
        <p class="practice__statement" data-reveal>{practice.statement}</p>
        <p class="practice__note" data-reveal style="--d:.06s">{practice.note}</p>
      </div>
      <div class="practice__lists">
        <div data-reveal style="--d:.08s">
          <h3 class="eyebrow">{practice.interestsLabel}</h3>
          <ul>{practice.interests.map((d) => <li>{d}</li>)}</ul>
        </div>
        <div data-reveal style="--d:.16s">
          <h3 class="eyebrow">{practice.toolsLabel}</h3>
          <ul class="tools">
            {tools.map((t, i) => (
              <li class="tool" style={`--tool-accent: var(${i % 2 ? "--sage-deep" : "--clay"})`}>
                <span class="tool__tile"><ToolIcon icon={t.icon} /></span>
                <span class="tool__name" lang="en">{t.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .practice { padding-block: clamp(4.5rem, 8vw, 7rem); background: var(--paper-light); border-block: 1px solid var(--rule); }
  .practice__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 6vw, 6.5rem); }
  .practice__title { font-size: var(--display-md); line-height: 1; margin-top: -0.3rem; }
  .practice__body { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .practice__intro { display: grid; gap: 1.2rem; }
  .practice__statement { font-family: var(--serif); font-weight: 330; font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem); line-height: 1.32; letter-spacing: -0.012em; max-width: 34rem; }
  .practice__note { color: var(--ink-soft); max-width: 30rem; }
  .practice__lists { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem clamp(2rem, 5vw, 4rem); max-width: 40rem; }
  .practice__lists h3 { margin-bottom: 1rem; }
  .practice__lists ul { border-top: 1px solid var(--rule); }
  .practice__lists li { padding-block: 0.75rem; border-bottom: 1px solid var(--rule); font-size: 0.98rem; }
  .tools li { display: flex; align-items: center; gap: 0.85rem; padding-block: calc(0.75rem - 0.3rem); }
  .tool__tile {
    flex: none; display: grid; place-items: center; width: 2.1rem; height: 2.1rem; margin-block: -0.15rem; border-radius: 0.6rem;
    background: var(--paper); box-shadow: inset 0 0 0 1px var(--rule);
    transition: background-color 0.5s var(--ease), box-shadow 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .tool:hover .tool__tile { background: var(--paper-deep); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tool-accent) 35%, transparent); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) { .tool__tile { transition: none; } .tool:hover .tool__tile { transform: none; } }
  @media (max-width: 760px) {
    .practice__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) { .practice__lists { grid-template-columns: 1fr; } }
</style>
