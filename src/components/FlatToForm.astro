---
import { Picture } from "astro:assets";
import { flatToForm as c } from "../content/content";
import FoldDemo from "./FoldDemo.astro";
---
<section id="flat-to-form" class="ftf chapter on-dark" aria-labelledby="ftf-title" data-chapter="03" data-chapter-title="Flat to Form" data-tone="dark">
  <header class="chapter__head ftf__head">
    <div class="ftf__intro">
      <p class="kicker" data-reveal>{c.kicker}</p>
      <h2 id="ftf-title" class="chapter__title display" data-mask>
        {c.title.map((t) => <span><span>{t}</span></span>)}
      </h2>
    </div>
    <div class="ftf__copy">
      <p class="lede" data-reveal>{c.lede}</p>
      <dl class="ftf__points">
        {c.points.map((pt) => (
          <div data-reveal>
            <dt>{pt.term}</dt>
            <dd>{pt.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <div class="ftf__demo" data-reveal>
    <div class="ftf__demo-head">
      <h3 class="ftf__demo-title display">{c.demoTitle}</h3>
      <p class="ftf__demo-note">{c.demoNote}</p>
    </div>
    <FoldDemo />
  </div>

  <figure class="ftf__figure" data-reveal>
    <div class="ftf__frame">
      <Picture src={c.image} alt={c.imageAlt} formats={["avif", "webp"]} widths={[640, 960, 1400, 2000]}
        sizes="(max-width: 760px) 100vw, 86vw" class="figure-img" data-parallax />
    </div>
    <figcaption><strong>{c.imageCaption.split(".")[0]}.</strong>{c.imageCaption.slice(c.imageCaption.indexOf(".") + 1)} Conceptual digital study.</figcaption>
  </figure>
</section>

<style>
  .ftf { background: var(--plum); overflow: hidden; }
  .ftf::before {
    /* faint dieline grid in the background */
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: 0.07;
    background-image:
      linear-gradient(to right, var(--brass) 1px, transparent 1px),
      linear-gradient(to bottom, var(--brass) 1px, transparent 1px);
    background-size: 6rem 6rem;
    mask-image: radial-gradient(80% 60% at 70% 30%, #000, transparent 75%);
  }
  .ftf__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; position: relative; }
  .ftf__intro { display: grid; gap: 2rem; }
  .ftf__copy { display: grid; gap: 2.5rem; }
  .ftf__points { display: grid; gap: 1.2rem; margin: 0; }
  .ftf__points > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding-top: 1.2rem; border-top: 1px solid rgb(245 242 236 / 0.16); }
  .ftf__points dt { font-family: var(--serif); font-style: italic; font-size: 1.35rem; color: var(--brass-bright); line-height: 1.2; }
  .ftf__points dd { margin: 0; color: rgb(245 242 236 / 0.75); font-size: 0.98rem; }

  .ftf__demo {
    position: relative; display: grid; gap: 2.5rem;
    padding: clamp(1.5rem, 4vw, 3.5rem); margin-bottom: clamp(5rem, 10vw, 9rem);
    border: 1px solid rgb(189 165 142 / 0.28); background: rgb(20 16 17 / 0.35);
  }
  .ftf__demo-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 2rem; }
  .ftf__demo-title { font-size: var(--step-2); font-style: italic; }
  .ftf__demo-note { font-size: var(--step--1); color: rgb(245 242 236 / 0.62); max-width: 26rem; }

  .ftf__figure { display: grid; gap: 1rem; margin-inline: auto; max-width: 86rem; }
  .ftf__frame { overflow: hidden; aspect-ratio: 10 / 7; }
  .ftf__frame :global(picture) { display: block; height: 100%; }

  @media (max-width: 860px) {
    .ftf__head { grid-template-columns: 1fr; }
    .ftf__points > div { grid-template-columns: 1fr; gap: 0.3rem; }
    .ftf__figure { margin-inline: calc(var(--gutter) * -1); }
    .ftf__figure figcaption { padding-inline: var(--gutter); }
    .ftf__frame { aspect-ratio: 4 / 3; }
  }
</style>
