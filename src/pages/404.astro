---
// One 404 page for every language (GitHub Pages serves a single 404.html). English first, then the
// same message in Swedish and Farsi, each with a link to its own home page.
import Base from "../layouts/Base.astro";
import { copy } from "../content/content";
import { locales } from "../i18n/locales";
const en = copy.en.notFound;
const others = (["sv", "fa"] as const).map((l) => ({ l, ...copy[l].notFound, ...locales[l] }));
---
<Base title="Page not found, Elham Kouhbor" noindex>
  <main id="main" class="nf">
    <p class="eyebrow eyebrow--rule">404</p>
    <h1 class="display">{en.title}</h1>
    <p class="lead">{en.text}</p>
    <a class="text-link" href="/">{en.home} <span class="arrow" aria-hidden="true">↗</span></a>
    <div class="nf__other">
      {others.map((o) => (
        <p lang={o.tag} dir={o.dir}>
          <span class="nf__title">{o.title}</span> <a href={o.path}>{o.home}</a>
        </p>
      ))}
    </div>
  </main>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; place-content: center; justify-items: start; gap: 1.5rem; padding: var(--gutter); max-width: 46rem; margin-inline: auto; }
  .nf h1 { font-size: var(--display-md); }
  .nf__other { display: grid; gap: 0.5rem; margin-top: 1rem; padding-top: 1.2rem; border-top: 1px solid var(--rule); width: 100%; color: var(--ink-soft); font-size: var(--text-sm); }
  .nf__other p[dir="rtl"] { font-family: var(--sans-fa); text-align: start; }
  .nf__other a { color: var(--ink); margin-inline-start: 0.4rem; }
</style>
