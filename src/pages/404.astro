---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — Elham Kouhbor" noindex>
  <main id="main" class="nf">
    <p class="eyebrow eyebrow--rule">404</p>
    <h1 class="display">This page has folded away.</h1>
    <p class="lead">The address may have changed — everything lives on a single page.</p>
    <a class="text-link" href="/">Return home <span class="arrow" aria-hidden="true">↗</span></a>
  </main>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; place-content: center; justify-items: start; gap: 1.5rem; padding: var(--gutter); max-width: 46rem; margin-inline: auto; }
  .nf h1 { font-size: var(--display-md); }
</style>
