---
import Base from "../layouts/Base.astro";
import Monogram from "../components/Monogram.astro";
---
<Base title="Page not found — Elham Kouhbor" noindex>
  <main id="main" class="nf">
    <Monogram class="nf__mono" />
    <h1 class="display">This page folded away.</h1>
    <p class="lede">The address may have changed. Everything lives on a single page.</p>
    <a class="link-underline nf__link" href="/">Return to the beginning →</a>
  </main>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; place-content: center; justify-items: start; gap: 1.5rem; padding: var(--gutter); max-width: 48rem; margin-inline: auto; }
  .nf :global(.nf__mono) { width: 6rem; }
  .nf h1 { font-size: var(--step-3); font-style: italic; }
  .nf__link { font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; font-size: var(--step--1); }
</style>
